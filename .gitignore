# Keep all Markdown documents local (planning notes, guides, overviews, reports)
*.md
# ...except the repository README
!/README.md

# Keep the written reports and Word documents local (personal tools)
*.docx
~$*.docx
reports/*
# ...but publish the run logs that back every reported number
!reports/logs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environments
.venv/
venv/
env/
.env

# Jupyter
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
