date-released: 2026-10-19
license: MIT
repository-code: "https://github.com/DolapoSalim/macroalgae_analysis_advance"
url: "https://dolaposalim.github.io/macroalgae_analysis_advance/"
keywords:
  - coral reef
  - macroalgae
  - resilience
  - tipping point
  - bistability
  - early-warning signals
  - identifiability
  - sensitivity analysis
